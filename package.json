{
  "name": "zefix-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for Swiss Company Registry (Zefix + UID Webservice) access",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
    "mcp",
    "zefix",
    "swiss",
    "company-registry",
    "uid"
  ],
  "author": "IndieGoWeb Ltd",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^16.4.5",
    "ky": "^1.7.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.2",
    "soap": "^1.1.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.15.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.3.3",
    "vitest": "^5.0.2"
  }
}
