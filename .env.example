# Zefix REST API Credentials
ZEFIX_USERNAME=your_username
ZEFIX_PASSWORD=your_password
ZEFIX_BASE_URL=https://www.zefix.admin.ch/ZefixPublicREST/api/v1

# UID Webservice (Public Services - no auth needed)
UID_PUBLIC_URL=https://www.uid-wse.admin.ch/V5.0/PublicServices.svc?wsdl

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600

# Logging
LOG_LEVEL=info
